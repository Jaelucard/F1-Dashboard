# Copy to backend/.env and fill in. backend/.env is gitignored and must never be committed.
OPENF1_USERNAME=
OPENF1_PASSWORD=
LIVE_MODE=false

# Serve a synthetic 22-car grid instead of connecting to OpenF1, so the UI can
# be checked outside a session window. Never connects to anything.
DEMO_MODE=false

# --- optional: feed and recorder ------------------------------------------
# No MQTT message for this long while connected -> the feed is STALE, not LIVE.
#FEED_STALE_SECONDS=15
# MQTT subscription QoS (1 = broker retransmits across a brief drop).
#MQTT_QOS=1
# Below this much free space on the recordings volume, /health reports disk_low.
#RECORDER_MIN_FREE_BYTES=524288000
# Messages buffered between the MQTT thread and the live adapter. Overflow is
# dropped from the dashboard only, never from the recording, and counted.
#FANOUT_QUEUE_SIZE=10000

# --- optional: WebSocket access control -------------------------------------
# Browser origins allowed to open /ws (comma-separated).
#WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Also refuse connections that send no Origin header at all (curl, websocat).
#WS_REQUIRE_ORIGIN=false
# Shared secret. When set, /ws needs ?token=<value> or "Authorization: Bearer".
# The browser reads VITE_WS_TOKEN at build time or localStorage['f1dash.wsToken'].
#WS_AUTH_TOKEN=
#WS_MAX_CLIENTS=16
#WS_SEND_TIMEOUT_SECONDS=5
